<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💬 Chat với Dược sĩ"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:background="@color/primary_blue"
        android:padding="16dp"
        android:gravity="center"
        android:textStyle="bold" />

    <!-- Nút xem thông tin bệnh nhân (chỉ STAFF thấy) -->
    <Button
        android:id="@+id/btnViewPatientInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👤 Xem thông tin bệnh nhân"
        android:layout_margin="12dp"
        android:backgroundTint="#FF9800"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- Khu vực hiển thị tin nhắn -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatStaff"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp" />

    <!-- Phần nhập tin nhắn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/white">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessageStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tin nhắn..."
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSendStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi"
            android:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            android:minHeight="48dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>